// This is your Prisma schema file for SNRL Manager
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// User Management (from 001-admin-user)
// ============================================================================

enum UserRole {
  admin
  editor
  member
}

enum UserStatus {
  active
  inactive
  deleted
}

model User {
  id            Int        @id @default(autoincrement())
  email         String     @unique @db.VarChar(255)
  password_hash String     @db.VarChar(255)
  role          UserRole   @default(member)
  status        UserStatus @default(active)
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  // Relationships from 001-admin-user
  series_permissions SeriesPermission[] @relation("UserSeriesPermissions")
  activity_logs      ActivityLog[]      @relation("ActivityLogActor")

  // Relationships from 003-database
  series_created   ContentSeries[]  @relation("SeriesCreator")
  content_authored ContentItem[]    @relation("ContentAuthor")
  versions_created ContentVersion[] @relation("VersionAuthor")

  // Relationships from 004-simracing-series
  championships_created ChampionshipRegistration[] @relation("DriverRegistrations")
  event_results         EventResult[]              @relation("DriverEventResults")
  session_results       SessionResult[]            @relation("DriverSessionResults")

  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

// ============================================================================
// Series Permissions (from 001-admin-user)
// ============================================================================

enum PermissionLevel {
  editor
}

model SeriesPermission {
  id           Int             @id @default(autoincrement())
  user_id      Int
  series_id    Int
  permission   PermissionLevel @default(editor)
  granted_by   Int
  granted_at   DateTime        @default(now())

  user         User            @relation("UserSeriesPermissions", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, series_id])
  @@index([series_id])
  @@map("series_permissions")
}

// ============================================================================
// Activity Log (from 001-admin-user)
// ============================================================================

enum ActivityAction {
  user_created
  user_updated
  user_deleted
  role_changed
  permission_granted
  permission_revoked
  series_created
  series_updated
  series_deleted
  content_created
  content_updated
  content_published
  content_archived
  version_created
  version_restored
}

model ActivityLog {
  id                 Int            @id @default(autoincrement())
  timestamp          DateTime       @default(now())
  admin_id           Int
  action             ActivityAction
  target_entity_type String         @db.VarChar(50)
  target_entity_id   Int
  changes            Json?

  admin User @relation("ActivityLogActor", fields: [admin_id], references: [id], onDelete: Restrict)

  @@index([admin_id, timestamp])
  @@index([target_entity_type, target_entity_id])
  @@index([timestamp(sort: Desc)])
  @@map("activity_logs")
}

// ============================================================================
// Content Series (from 003-database)
// ============================================================================

enum SeriesStatus {
  active
  deleted
}

model ContentSeries {
  id          Int          @id @default(autoincrement())
  title       String       @db.VarChar(200)
  description String?      @db.Text
  created_by  Int
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt
  status      SeriesStatus @default(active)

  // Relationships
  creator User          @relation("SeriesCreator", fields: [created_by], references: [id], onDelete: Restrict)
  content ContentItem[] @relation("SeriesContent")

  // Indexes
  @@index([title])
  @@index([created_by])
  @@index([status])
  @@index([created_at(sort: Desc)])
  @@map("content_series")
}

// ============================================================================
// Content Item (from 003-database)
// ============================================================================

enum ContentStatus {
  draft
  published
  archived
}

model ContentItem {
  id                Int           @id @default(autoincrement())
  series_id         Int
  title             String        @db.VarChar(500)
  body              String        @db.Text
  author_id         Int
  status            ContentStatus @default(draft)
  current_version   Int           @default(1)
  published_version Int?
  created_at        DateTime      @default(now())
  published_at      DateTime?
  updated_at        DateTime      @updatedAt

  // Full-text search support (PostgreSQL tsvector)
  search_vector Unsupported("tsvector")?

  // Relationships
  series   ContentSeries     @relation("SeriesContent", fields: [series_id], references: [id], onDelete: Cascade)
  author   User              @relation("ContentAuthor", fields: [author_id], references: [id], onDelete: Restrict)
  versions ContentVersion[]  @relation("ContentVersions")
  metadata ContentMetadata?  @relation("ContentMetadata")

  // Indexes
  @@index([series_id])
  @@index([author_id])
  @@index([status])
  @@index([published_at(sort: Desc)])
  @@index([title])
  @@index([search_vector], type: Gin)
  @@map("content_items")
}

// ============================================================================
// Content Version (from 003-database)
// ============================================================================

model ContentVersion {
  id              Int      @id @default(autoincrement())
  content_item_id Int
  version_number  Int
  title           String   @db.VarChar(500)
  body            String   @db.Text
  author_id       Int
  created_at      DateTime @default(now())
  is_current      Boolean  @default(false)

  // Relationships
  content_item ContentItem @relation("ContentVersions", fields: [content_item_id], references: [id], onDelete: Cascade)
  author       User        @relation("VersionAuthor", fields: [author_id], references: [id], onDelete: Restrict)

  // Indexes
  @@unique([content_item_id, version_number], name: "unique_content_version")
  @@index([content_item_id, version_number(sort: Desc)])
  @@index([created_at(sort: Desc)])
  @@index([is_current])
  @@map("content_versions")
}

// ============================================================================
// Content Metadata (from 003-database)
// ============================================================================

model ContentMetadata {
  id                  Int       @id @default(autoincrement())
  content_item_id     Int       @unique
  view_count          Int       @default(0)
  unique_viewer_count Int       @default(0)
  last_viewed_at      DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  // Relationships
  content_item ContentItem @relation("ContentMetadata", fields: [content_item_id], references: [id], onDelete: Cascade)

  // Indexes
  @@index([view_count(sort: Desc)])
  @@index([last_viewed_at(sort: Desc)])
  @@map("content_metadata")
}

// ============================================================================
// Simracing Championship Series (from 004-simracing-series)
// ============================================================================

enum ChampionshipStatus {
  DRAFT
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum EventStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SessionType {
  PRACTICE
  QUALIFYING
  SPRINT_RACE
  FEATURE_RACE
  RACE
}

enum ResultStatus {
  CLASSIFIED
  DNF
  DNS
  DSQ
}

enum RaceLengthUnit {
  LAPS
  MINUTES
  HOURS
}

enum PenaltyType {
  TIME_PENALTY
  POSITION_PENALTY
  POINTS_DEDUCTION
}

enum RegistrationStatus {
  ACTIVE
  WITHDRAWN
}

model Championship {
  id                    Int                         @id @default(autoincrement())
  name                  String                      @db.VarChar(255)
  description           String?                     @db.Text
  simulator             String                      @db.VarChar(100)
  seasonStart           DateTime                    @db.Date
  seasonEnd             DateTime                    @db.Date
  status                ChampionshipStatus          @default(DRAFT)
  rulesText             String?                     @db.Text
  rulesDocumentUrl      String?                     @db.VarChar(500)
  maxParticipants       Int?
  pointsSchemeId        Int
  pointsScheme          PointsScheme                @relation(fields: [pointsSchemeId], references: [id])
  events                Event[]
  registrations         ChampionshipRegistration[]
  allowedCars           AllowedCar[]
  standings             ChampionshipStanding[]
  calendarSubscriptions CalendarSubscription[]
  createdBy             Int
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  @@index([status])
  @@index([simulator])
  @@index([createdBy])
  @@index([seasonStart, seasonEnd])
  @@map("championships")
}

model ChampionshipRegistration {
  id               Int                  @id @default(autoincrement())
  championshipId   Int
  championship     Championship         @relation(fields: [championshipId], references: [id], onDelete: Cascade)
  driverId         Int
  driver           User                 @relation("DriverRegistrations", fields: [driverId], references: [id])
  status           RegistrationStatus   @default(ACTIVE)
  registeredAt     DateTime             @default(now())
  withdrawnAt      DateTime?
  withdrawalReason String?              @db.Text

  @@unique([championshipId, driverId])
  @@index([driverId])
  @@index([championshipId, status])
  @@map("championship_registrations")
}

model Event {
  id                    Int             @id @default(autoincrement())
  championshipId        Int
  championship          Championship    @relation(fields: [championshipId], references: [id], onDelete: Cascade)
  name                  String          @db.VarChar(255)
  track                 String          @db.VarChar(255)
  eventDate             DateTime
  status                EventStatus     @default(SCHEDULED)
  raceLengthValue       Int
  raceLengthUnit        RaceLengthUnit
  originalEventDate     DateTime?
  cancellationReason    String?         @db.Text
  cancelledAt           DateTime?
  cancelledBy           Int?
  rescheduleDateHistory Json?
  raceSessions          RaceSession[]
  results               EventResult[]
  createdBy             Int
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([championshipId])
  @@index([eventDate])
  @@index([championshipId, status])
  @@index([championshipId, eventDate])
  @@map("events")
}

model RaceSession {
  id                 Int            @id @default(autoincrement())
  eventId            Int
  event              Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sessionName        String         @db.VarChar(255)
  sessionType        SessionType
  sessionOrder       Int
  durationValue      Int
  durationUnit       RaceLengthUnit
  pointsMultiplier   Float          @default(1.0)
  scheduledStartTime DateTime?
  results            SessionResult[]

  @@index([eventId])
  @@index([eventId, sessionOrder])
  @@map("race_sessions")
}

model EventResult {
  id                  Int          @id @default(autoincrement())
  eventId             Int
  event               Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  driverId            Int
  driver              User         @relation("DriverEventResults", fields: [driverId], references: [id])
  finishingPosition   Int?
  originalPosition    Int?
  resultStatus        ResultStatus @default(CLASSIFIED)
  penalties           Json?
  pointsAwarded       Int          @default(0)
  isDraft             Boolean      @default(true)
  publishedAt         DateTime?
  enteredBy           Int
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  modificationHistory Json?

  @@unique([eventId, driverId])
  @@index([driverId])
  @@index([eventId, resultStatus])
  @@index([eventId, driverId, resultStatus, pointsAwarded])
  @@map("event_results")
}

model SessionResult {
  id                  Int          @id @default(autoincrement())
  sessionId           Int
  session             RaceSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  driverId            Int
  driver              User         @relation("DriverSessionResults", fields: [driverId], references: [id])
  finishingPosition   Int?
  originalPosition    Int?
  resultStatus        ResultStatus @default(CLASSIFIED)
  penalties           Json?
  pointsAwarded       Int          @default(0)
  isDraft             Boolean      @default(true)
  publishedAt         DateTime?
  enteredBy           Int
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  modificationHistory Json?

  @@unique([sessionId, driverId])
  @@index([driverId])
  @@index([sessionId, resultStatus])
  @@map("session_results")
}

model PointsScheme {
  id            Int            @id @default(autoincrement())
  name          String         @db.VarChar(255)
  description   String?        @db.Text
  pointsMapping Json
  bonusPoints   Json?
  dropScores    Int            @default(0)
  championships Championship[]
  createdBy     Int
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([name])
  @@map("points_schemes")
}

model ChampionshipStanding {
  id                 Int          @id @default(autoincrement())
  championshipId     Int
  championship       Championship @relation(fields: [championshipId], references: [id], onDelete: Cascade)
  driverId           Int
  totalPoints        Int          @default(0)
  eventsParticipated Int          @default(0)
  wins               Int          @default(0)
  podiums            Int          @default(0)
  bestFinish         Int?
  position           Int
  pointsBreakdown    Json
  lastCalculated     DateTime     @default(now())

  @@unique([championshipId, driverId])
  @@index([championshipId, position])
  @@index([championshipId, totalPoints])
  @@map("championship_standings")
}

model AllowedCar {
  id             Int          @id @default(autoincrement())
  championshipId Int
  championship   Championship @relation(fields: [championshipId], references: [id], onDelete: Cascade)
  carName        String       @db.VarChar(255)
  carClass       String?      @db.VarChar(100)

  @@unique([championshipId, carName])
  @@index([championshipId])
  @@map("allowed_cars")
}

model ChampionshipImport {
  id                     Int       @id @default(autoincrement())
  sourceUrl              String    @db.VarChar(1000)
  parsedChampionshipName String?   @db.VarChar(255)
  parsedSeasonStart      DateTime? @db.Date
  parsedSeasonEnd        DateTime? @db.Date
  parsedEvents           Json?
  status                 String    @db.VarChar(50)
  errorMessage           String?   @db.Text
  createdBy              Int
  createdAt              DateTime  @default(now())
  importedAs             Int?

  @@index([createdBy])
  @@index([status])
  @@map("championship_imports")
}

model CalendarSubscription {
  id             Int          @id @default(autoincrement())
  championshipId Int
  championship   Championship @relation(fields: [championshipId], references: [id], onDelete: Cascade)
  token          String       @unique @db.VarChar(64)
  userId         Int?
  createdAt      DateTime     @default(now())
  lastAccessedAt DateTime?
  accessCount    Int          @default(0)

  @@index([championshipId])
  @@index([token])
  @@map("calendar_subscriptions")
}
